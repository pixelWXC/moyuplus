{
  "name": "moyuplus",
  "displayName": "moyuplus",
  "description": "Local TXT reader and typing practice tools for VS Code.",
  "version": "0.0.1",
  "publisher": "local",
  "private": true,
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:moyuplus.smokeTest",
    "onCommand:moyuplus.importTxt",
    "onCommand:moyuplus.removeImportedTxt",
    "onCommand:moyuplus.checkImportedTxtFiles",
    "onView:moyuplus.readerView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "moyuplus.smokeTest",
        "title": "MoyuPlus: Smoke Test"
      },
      {
        "command": "moyuplus.importTxt",
        "title": "MoyuPlus: Import TXT"
      },
      {
        "command": "moyuplus.removeImportedTxt",
        "title": "MoyuPlus: Remove Imported TXT"
      },
      {
        "command": "moyuplus.checkImportedTxtFiles",
        "title": "MoyuPlus: Check Imported TXT Files"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "moyuplus.readerView",
          "type": "webview",
          "name": "MoyuPlus Reader"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.92.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
