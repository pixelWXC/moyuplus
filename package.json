{
  "name": "moyuplus",
  "displayName": "moyuplus",
  "description": "Local TXT reader and typing practice tools for VS Code.",
  "version": "0.2.0",
  "publisher": "local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/pixelWXC/moyuplus.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:moyuplus.smokeTest",
    "onCommand:moyuplus.importBook",
    "onCommand:moyuplus.removeBook",
    "onCommand:moyuplus.relocateBook",
    "onCommand:moyuplus.startTypingPractice",
    "onCommand:moyuplus.stopTypingPractice",
    "onCommand:moyuplus.nextTypingPracticeLine",
    "onCommand:moyuplus.resetTypingPracticeProgress",
    "onCommand:moyuplus.jumpToTypingPracticeLine",
    "onCommand:moyuplus.toggleTypingPracticeLineEdgeTrim",
    "onCommand:moyuplus.routeEnter",
    "onCommand:moyuplus.reader.nextPage",
    "onCommand:moyuplus.reader.previousPage",
    "onCommand:moyuplus.reader.undoLocation",
    "onCommand:moyuplus.reader.previousChapter",
    "onCommand:moyuplus.reader.nextChapter",
    "onCommand:moyuplus.reader.openLibrary",
    "onCommand:moyuplus.reader.openToc",
    "onCommand:moyuplus.reader.openSettings",
    "onCommand:moyuplus.openSettings",
    "onCommand:moyuplus.reader.focus",
    "onCommand:moyuplus.reader.close",
    "onCommand:moyuplus.immersive.stop",
    "onCommand:moyuplus.gitLog.toggle",
    "onCommand:moyuplus.toggleTypingPractice",
    "onView:moyuplus.readerView",
    "onView:moyuplus.typingView",
    "onCustomEditor:moyuplus.imagePreview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "moyuplus.importBook",
        "title": "MoyuPlus: Import Book"
      },
      {
        "command": "moyuplus.removeBook",
        "title": "MoyuPlus: Remove Book"
      },
      {
        "command": "moyuplus.relocateBook",
        "title": "MoyuPlus: Relocate Book"
      },
      {
        "command": "moyuplus.smokeTest",
        "title": "MoyuPlus: Smoke Test"
      },
      {
        "command": "moyuplus.startTypingPractice",
        "title": "MoyuPlus: Start Typing Practice"
      },
      {
        "command": "moyuplus.stopTypingPractice",
        "title": "MoyuPlus: Stop Typing Practice"
      },
      {
        "command": "moyuplus.resetTypingPracticeProgress",
        "title": "MoyuPlus: Reset Typing Practice Progress"
      },
      {
        "command": "moyuplus.routeEnter",
        "title": "MoyuPlus: Route Enter"
      },
      {
        "command": "moyuplus.reader.nextPage",
        "title": "MoyuPlus: Reader Next Page"
      },
      {
        "command": "moyuplus.reader.previousPage",
        "title": "MoyuPlus: Reader Previous Page"
      },
      {
        "command": "moyuplus.reader.undoLocation",
        "title": "MoyuPlus: Undo Reader Location"
      },
      {
        "command": "moyuplus.reader.previousChapter",
        "title": "MoyuPlus: Reader Previous Chapter"
      },
      {
        "command": "moyuplus.reader.nextChapter",
        "title": "MoyuPlus: Reader Next Chapter"
      },
      {
        "command": "moyuplus.reader.openLibrary",
        "title": "MoyuPlus: Open Library"
      },
      {
        "command": "moyuplus.reader.openToc",
        "title": "MoyuPlus: Open Table of Contents"
      },
      {
        "command": "moyuplus.reader.openSettings",
        "title": "MoyuPlus: Open Reader Settings"
      },
      {
        "command": "moyuplus.openSettings",
        "title": "MoyuPlus Settings"
      },
      {
        "command": "moyuplus.reader.focus",
        "title": "MoyuPlus: Open Reader"
      },
      {
        "command": "moyuplus.reader.close",
        "title": "MoyuPlus: Close Reader"
      },
      {
        "command": "moyuplus.immersive.stop",
        "title": "MoyuPlus: Stop Immersive Reading"
      },
      {
        "command": "moyuplus.gitLog.toggle",
        "title": "MoyuPlus: Toggle Git Log"
      },
      {
        "command": "moyuplus.toggleTypingPractice",
        "title": "MoyuPlus: Toggle Typing Practice"
      }
    ],
    "keybindings": [
      {
        "command": "moyuplus.immersive.stop",
        "key": "alt+shift+q",
        "when": "moyuplus.immersiveReadingActive"
      },
      {
        "command": "moyuplus.gitLog.toggle",
        "key": "alt+q"
      },
      {
        "command": "moyuplus.routeEnter",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && config.moyuplus.shortcuts.enableEnterRouter"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "moyuplus.immersive.stop",
          "when": "moyuplus.immersiveReadingActive",
          "group": "navigation@99"
        },
        {
          "command": "moyuplus.openSettings",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "moyuplus.gitLog.toggle",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "MoyuPlus",
      "properties": {
        "moyuplus.shortcuts.enableEnterRouter": {
          "type": "boolean",
          "default": false,
          "description": "启用 Enter 路由。关闭时，Enter 完全保持 VS Code 原生行为；开启后会按下面的 Enter 设置执行组合动作。"
        },
        "moyuplus.enter.insertNewLine": {
          "type": "boolean",
          "default": true,
          "description": "路由 Enter 时先插入真实换行。建议保持开启，避免改变编辑器的基本输入习惯。"
        },
        "moyuplus.enter.nextReaderPage": {
          "type": "boolean",
          "default": false,
          "description": "路由 Enter 后请求阅读器翻到下一页；阅读器视图需要已打开并选中文件。"
        },
        "moyuplus.typing.practiceFontSize": {
          "type": "number",
          "default": 34,
          "minimum": 18,
          "maximum": 64,
          "description": "打字练习对照行与输入行的字号（像素）。"
        },
        "moyuplus.typing.practiceLineHeight": {
          "type": "number",
          "default": 1.6,
          "minimum": 1.2,
          "maximum": 2.4,
          "description": "打字练习对照行与输入行的行高。"
        },
        "moyuplus.typing.practiceFontFamily": {
          "type": "string",
          "enum": [
            "editor",
            "interface"
          ],
          "enumDescriptions": [
            "使用 VS Code 编辑器字体",
            "使用 VS Code 界面字体"
          ],
          "default": "editor",
          "description": "打字练习对照文章使用的字体。"
        },
        "moyuplus.typing.showVirtualKeyboard": {
          "type": "boolean",
          "default": true,
          "description": "在练习面板显示虚拟键盘和下一个按键提示。"
        },
        "moyuplus.typing.colorKeyboardHands": {
          "type": "boolean",
          "default": true,
          "description": "用不同颜色标记虚拟键盘上左手与右手负责的按键区域。"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "moyuplus.imagePreview",
        "displayName": "MoyuPlus Image Preview",
        "selector": [
          {
            "filenamePattern": "*.moyuplus-image"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moyuplus-typing",
          "title": "MoyuPlus Typing",
          "icon": "media/typing-view.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "moyuplus.readerView",
          "type": "webview",
          "name": "MoyuPlus Reader"
        }
      ],
      "moyuplus-typing": [
        {
          "id": "moyuplus.typingView",
          "type": "webview",
          "name": "打字练习"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:webview": "node scripts/build.mjs --webview-only",
    "compile": "tsc -p ./ --noEmit && npm run build",
    "watch": "tsc -watch -p ./",
    "test:unit": "vitest run",
    "test:extension-host": "npm run build && node scripts/run-extension-host-tests.mjs",
    "test:typing-ime-manual": "npm run build && node scripts/run-extension-host-tests.mjs --ime-manual",
    "test:layout": "playwright test --config playwright.config.ts",
    "test": "npm run test:unit && npm run test:layout",
    "package": "npm run compile && npm test && vsce package"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3",
    "iconv-lite": "^0.6.3",
    "parse5": "^8.0.1",
    "pinyin-pro": "^3.28.2",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.92.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yazl": "^3.3.1"
  }
}
